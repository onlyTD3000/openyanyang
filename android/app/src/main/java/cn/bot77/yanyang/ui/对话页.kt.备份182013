/**
 * 检查图片是否超出上限，返回 0 表示未超出，>0 表示超出的实际 KB 数
 */
private fun 需要确认压缩(上下文: android.content.Context, uri: android.net.Uri, 上限KB: Int): Int {
    return try {
        上下文.contentResolver.openInputStream(uri)?.use { 流 ->
            val 字节数 = 流.available()
            val 实际KB = 字节数 / 1024
            if (实际KB > 上限KB) 实际KB else 0
        } ?: 0
    } catch (_: Exception) {
        0
    }
}

/**
 * 压缩并上传图片
 */
private fun 压缩并上传(
    上下文: android.content.Context,
    uri: android.net.Uri,
    状态: 主状态,
    上限KB: Int
) {
    try {
        val 原图 = 上下文.contentResolver.openInputStream(uri)?.use {
            android.graphics.BitmapFactory.decodeStream(it)
        } ?: run {
            状态.提示.value = "读取图片失败"
            return
        }
        
        // 分级压缩：先尝试 80 质量，不行就 60，还不行就 40，实在不行就放弃
        var 质量 = 80
        var 压缩结果: ByteArray? = null
        while (质量 >= 40) {
            val 输出流 = java.io.ByteArrayOutputStream()
            原图.compress(android.graphics.Bitmap.CompressFormat.JPEG, 质量, 输出流)
            val 字节 = 输出流.toByteArray()
            if (字节.size / 1024 <= 上限KB) {
                压缩结果 = 字节
                break
            }
            质量 -= 20
        }
        
        if (压缩结果 == null) {
            状态.提示.value = "压缩后仍超过上限，请换一张图"
            return
        }
        
        // 转 base64 并上传
        val base64 = android.util.Base64.encodeToString(
            压缩结果,
            android.util.Base64.NO_WRAP
        )
        状态.加图(压缩结果, "${System.currentTimeMillis()}.jpg", "image/jpeg", uri.toString())
    } catch (e: Exception) {
        状态.提示.value = "处理图片失败：${e.message}"
    }
}

/**
 * 侧栏：项目列表 + 对话管理
 *
 * 逻辑：用户可以有多个项目，每个项目下有多条对话。
 * 侧栏顶部显示项目列表（可切换、新建、删除），下面展示当前项目下的对话列表。
 * 对话可以新建、删除、重命名，点击对话切换到那条去。
 */
