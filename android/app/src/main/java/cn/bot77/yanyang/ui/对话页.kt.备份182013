private fun 侧栏(状态: 主状态, 关抽屉: () -> Unit) {
    var 展开项目选择 by remember { mutableStateOf(false) }
    var 新建项目弹窗 by remember { mutableStateOf(false) }
    var 重命名项目弹窗 by remember { mutableStateOf(false) }
    var 删项目确认 by remember { mutableStateOf(false) }
    var 新建对话弹窗 by remember { mutableStateOf(false) }
    var 重命名对话弹窗 by remember { mutableStateOf<会话?>(null) }
    var 删对话确认 by remember { mutableStateOf<会话?>(null) }
    Column(Modifier.fillMaxSize()) {
        // 顶部：当前项目名 + 下拉按钮
        Row(
            Modifier
                .fillMaxWidth()
                .clickable { 展开项目选择 = !展开项目选择 }
                .padding(16.dp),
            verticalAlignment = Alignment.CenterVertically
        ) {
            Text(
                状态.当前会话.value?.项目id?.let { pid -> 状态.项目表.find { it.id == pid }?.名称 } ?: "未选项目",
                style = MaterialTheme.typography.titleMedium,
                modifier = Modifier.weight(1f)
            )
            Icon(
                if (展开项目选择) Icons.Filled.KeyboardArrowDown else Icons.Filled.ArrowDropDown,
                contentDescription = null
            )
        }
        // 项目列表展开区
        if (展开项目选择) {
            Column(
                Modifier
                    .fillMaxWidth()
                    .background(MaterialTheme.colorScheme.surfaceVariant)
                    .padding(vertical = 8.dp)
            ) {
                状态.项目表.forEach { 项目 ->
                    Row(
                        Modifier
                            .fillMaxWidth()
                            .clickable {
                                // 切换到该项目下的第一个会话
                                val 第一会话 = 状态.项目下会话(项目.id).firstOrNull()
                                if (第一会话 != null) {
                                    状态.选会话(第一会话)
                                }
                                展开项目选择 = false
                            }
                            .padding(horizontal = 16.dp, vertical = 12.dp),
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        Text(
                            项目.名称,
                            style = MaterialTheme.typography.bodyMedium,
                            modifier = Modifier.weight(1f),
                            fontWeight = if (项目.id == 状态.当前会话.value?.项目id)
                                FontWeight.Bold else FontWeight.Normal
                        )
                    }
                }
                HorizontalDivider(Modifier.padding(vertical = 4.dp))
                TextButton(
                    onClick = {
                        新建项目弹窗 = true
                        展开项目选择 = false
                    },
                    modifier = Modifier.fillMaxWidth()
                ) {
                    Icon(Icons.Filled.Add, contentDescription = null, modifier = Modifier.size(18.dp))
                    Spacer(Modifier.width(8.dp))
                    Text("新建项目")
                }
            }
        }
        HorizontalDivider()
        // 当前项目操作按钮
        if (状态.当前项目.value != null) {
            Row(
                Modifier
                    .fillMaxWidth()
                    .padding(horizontal = 8.dp, vertical = 4.dp),
                horizontalArrangement = Arrangement.spacedBy(4.dp)
            ) {
                TextButton(onClick = { 重命名项目弹窗 = true }) {
                    Icon(Icons.Filled.Edit, contentDescription = null, modifier = Modifier.size(16.dp))
                    Spacer(Modifier.width(4.dp))
                    Text("改名", style = MaterialTheme.typography.bodySmall)
                }
                TextButton(onClick = { 删项目确认 = true }) {
                    Icon(Icons.Filled.Delete, contentDescription = null, modifier = Modifier.size(16.dp))
                    Spacer(Modifier.width(4.dp))
                    Text("删除", style = MaterialTheme.typography.bodySmall)
                }
                Spacer(Modifier.weight(1f))
                TextButton(onClick = {
                    新建对话弹窗 = true
                }) {
                    Icon(Icons.Filled.Add, contentDescription = null, modifier = Modifier.size(16.dp))
                    Spacer(Modifier.width(4.dp))
                    Text("新对话", style = MaterialTheme.typography.bodySmall)
                }
            }
            HorizontalDivider()
        }
        // 对话列表
        if (状态.对话列表.isEmpty()) {
            Box(
                Modifier
                    .fillMaxWidth()
                    .padding(24.dp),
                contentAlignment = Alignment.Center
            ) {
                Text(
                    "还没有对话\n点右上角新建一条",
                    style = MaterialTheme.typography.bodySmall,
                    color = MaterialTheme.colorScheme.onSurfaceVariant,
                    textAlign = TextAlign.Center
                )
            }
        } else {
            LazyColumn(Modifier.weight(1f)) {
                items(状态.对话列表, key = { it.id }) { 会话 ->
                    val 是当前 = 会话.id == 状态.当前会话.value?.id
                    Row(
                        Modifier
                            .fillMaxWidth()
                            .clickable {
                                状态.切换会话(会话)
                                关抽屉()
                            }
                            .background(
                                if (是当前) MaterialTheme.colorScheme.secondaryContainer
                                else Color.Transparent
                            )
                            .padding(horizontal = 16.dp, vertical = 12.dp),
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        Text(
                            会话.标题,
                            style = MaterialTheme.typography.bodyMedium,
                            modifier = Modifier.weight(1f),
                            maxLines = 1,
                            overflow = TextOverflow.Ellipsis,
                            fontWeight = if (是当前) FontWeight.Bold else FontWeight.Normal
                        )
                        IconButton(
                            onClick = { 重命名对话弹窗 = 会话 },
                            modifier = Modifier.size(32.dp)
                        ) {
                            Icon(
                                Icons.Filled.Edit,
                                contentDescription = "改名",
                                modifier = Modifier.size(18.dp)
                            )
                        }
                        IconButton(
                            onClick = { 删对话确认 = 会话 },
                            modifier = Modifier.size(32.dp)
                        ) {
                            Icon(
                                Icons.Filled.Delete,
                                contentDescription = "删除",
                                modifier = Modifier.size(18.dp)
                            )
                        }
                    }
                }
            }
        }
        HorizontalDivider()
        // 底部：工作中心、代码仓、充值、个人中心
        Column(Modifier.padding(8.dp), verticalArrangement = Arrangement.spacedBy(4.dp)) {
            TextButton(
                onClick = {
                    状态.开工作中心页()
                    关抽屉()
                },
                modifier = Modifier.fillMaxWidth()
            ) {
                Icon(Icons.Filled.Folder, contentDescription = null, modifier = Modifier.size(18.dp))
                Spacer(Modifier.width(8.dp))
                Text("工作中心")
            }
