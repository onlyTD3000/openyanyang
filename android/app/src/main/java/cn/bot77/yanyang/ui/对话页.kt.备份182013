            ) {
                Icon(Icons.Filled.Folder, contentDescription = null, modifier = Modifier.size(18.dp))
                Spacer(Modifier.width(8.dp))
                Text("代码仓")
            }
            TextButton(
                onClick = {
                    状态.开充值页()
                    关抽屉()
                },
                modifier = Modifier.fillMaxWidth()
            ) {
                Text("💰 充值")
            }
            TextButton(
                onClick = {
                    状态.开个人中心页()
                    关抽屉()
                },
                modifier = Modifier.fillMaxWidth()
            ) {
                Text("👤 ${状态.我的.value.用户名.ifBlank { "个人中心" }}")
            }
        }
    }
    // --- 弹窗们 ---
    if (新建项目弹窗) {
        输入弹窗(
            标题 = "新建项目",
            初值 = "",
            确认文本 = "创建",
            取消 = { 新建项目弹窗 = false }
        ) { 名称 ->
            状态.新建项目(名称)
            新建项目弹窗 = false
        }
    }
    if (重命名项目弹窗) {
        输入弹窗(
            标题 = "重命名项目",
            初值 = 状态.当前项目.value?.名称 ?: "",
            确认文本 = "保存",
            取消 = { 重命名项目弹窗 = false }
        ) { 新名 ->
            状态.当前项目.value?.let { 状态.重命名项目(it, 新名) }
            重命名项目弹窗 = false
        }
    }
    if (删项目确认) {
        AlertDialog(
            onDismissRequest = { 删项目确认 = false },
            title = { Text("确认删除") },
            text = { Text("删除项目会同时删除项目下的所有对话，确定吗？") },
            confirmButton = {
