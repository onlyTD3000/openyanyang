                    },
                    confirmButton = {
                        TextButton(onClick = {
                            if (名称.isBlank()) {
                                错误信息 = "请填写项目名称"
                            } else {
                                状态.改项目(
                                    原项.copy(
                                        名称 = 名称.trim(),
                                        简介 = 简介.trim(),
                                        技术栈 = 技术栈.trim(),
                                        主机id = 选服务器,
