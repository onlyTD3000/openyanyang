                id = o.optString("id"),
                名称 = o.optString("name").ifBlank { "未命名项目" },
                简介 = o.optString("intro"),
                技术栈 = o.optString("stack"),
                主机id = o.optString("host_id"),
                部署目录 = o.optString("deploy_dir"),
                站点地址 = o.optString("site_url"),
                颜色 = o.optString("color")
            )
        }
    }
