        return r.optString("conv_id").ifBlank { r.optString("id").ifBlank { null } }
    }
    fun 删会话(会话id: String): Boolean {
        val r = 接口.调("/api/conv.php", mapOf("act" to "del", "conv_id" to 会话id), "POST", 密钥源())
