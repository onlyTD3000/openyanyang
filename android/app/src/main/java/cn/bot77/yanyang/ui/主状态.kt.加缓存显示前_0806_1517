     * 顶栏返回箭头走这里：语义是「回上一页」，跟系统返回键一致，
     * 不是「回首页」。以前这里清空整个栈直接跳对话页，用户从
     * 代码仓进服务器登记再按箭头会一步跨回对话页，中间那层丢了。
     */
    fun 回对话() {
        if (!按返回()) {
            // 栈空了（直接落在某个二级页）才兜底回对话页
            当前屏.value = 屏幕.对话
            提示.value = ""
